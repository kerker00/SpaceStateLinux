" height="18" as="geometry"/></mxCell><mxCell id="label-0-4" value="SSE through /v1/stream" style="text;html=1;fontSize=12;fontColor=#b96a00;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="858" y="293" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-0-5" value="ping every 25 s, ends after 1 h" style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="858" y="309" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-0-6" value="change" style="text;html=1;fontSize=12;fontColor=#b96a00;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="858" y="467" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-0-7" value="chosen only" style="text;html=1;fontSize=12;fontColor=#b96a00;fontStyle=1;align=right;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="348" y="582" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-0-8" value="GNotification" style="text;html=1;fontSize=12;fontColor=#b96a00;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="615" y="703" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-0-9" value="also, for iOS and macOS" style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="710.0" y="33" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-0-10" value="stores" style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="375" y="157" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-0-11" value="serves" style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="365.0" y="203" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-0-12" value="after every connection," style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=right;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="355" y="293" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-0-13" value="every few minutes during an outage" style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=right;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="355" y="309" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-0-14" value="states" style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=right;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="355" y="467" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-0-15" value="icon, menu" style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="855" y="582" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-0-16" value="StatusNotifierItem," style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="855" y="703" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-0-17" value="dbusmenu" style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="855" y="719" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-0-18" value="GFileMonitor" style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="375" y="703" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-0-19" value="restarts with new topics" style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="375" y="512" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-0-20" value="writes" style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="125.0" y="811" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-0-21" value="spacestate add" style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="135" y="709" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-0-22" value='"Settings..." in the menu, or a click on a notification, starts the window' style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="265.0" y="875" width="440" height="18" as="geometry"/></mxCell><mxCell id="note-0-0" value="SpaceStateLinux architecture" style="text;html=1;fontSize=15;fontColor=#1b1e24;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="13" width="220" height="18" as="geometry"/></mxCell><mxCell id="note-0-1" value="Orange: path of a change." style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="33" width="220" height="18" as="geometry"/></mxCell><mxCell id="note-0-2" value="Dashed: outside that path." style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="49" width="220" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-1" name="When the stream is missing"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="320" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="connected" value='&lt;b&gt;Connected&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 12px" color="#5c6270"&gt;changes arrive at once, tray shows the states&lt;/font&gt;' style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=15;fontColor=#1b1e24;fillColor=#fff0d6;strokeColor=#b96a00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="210" height="86" as="geometry"/></mxCell><mxCell id="short" value='&lt;b&gt;Briefly interrupted&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 12px" color="#5c6270"&gt;reconnects, up to 5 min apart; tray shows unknown&lt;/font&gt;' style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=15;fontColor=#1b1e24;fillColor=#ffffff;strokeColor=#8b909b;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="210" height="86" as="geometry"/></mxCell><mxCell id="long" value='&lt;b&gt;Unavailable for longer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 12px" color="#5c6270"&gt;reads at each attempt; notifications are delayed&lt;/font&gt;' style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=15;fontColor=#1b1e24;fillColor=#ffffff;strokeColor=#8b909b;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="210" height="86" as="geometry"/></mxCell><mxCell id="refused" value='&lt;b&gt;Refused&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 12px" color="#5c6270"&gt;reads every 5 minutes, until the configuration changes&lt;/font&gt;' style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=15;fontColor=#1b1e24;fillColor=#ffffff;strokeColor=#8b909b;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="910" y="180" width="210" height="86" as="geometry"/></mxCell><mxCell id="edge-1-0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8b909b;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="connected" target="short"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-1-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8b909b;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="short" target="long"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-1-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8b909b;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="short" target="connected"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="435" y="34"/><mxPoint x="145" y="34"/></Array></mxGeometry></mxCell><mxCell id="edge-1-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8b909b;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="long" target="connected"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="725" y="-6"/><mxPoint x="124" y="-6"/></Array></mxGeometry></mxCell><mxCell id="edge-1-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8b909b;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="connected" target="refused"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="145" y="223"/></Array></mxGeometry></mxCell><mxCell id="label-1-0" value="stream lost" style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="170.0" y="77" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-1-1" value="wait of" style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="460.0" y="77" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-1-2" value="30 s or more" style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="460.0" y="109" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-1-3" value="connected, reads the states" style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="170.0" y="13" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-1-4" value="stream back" style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="460.0" y="-25" width="240" height="18" as="geometry"/></mxCell><mxCell id="label-1-5" value="SpacePush answers 400 or 404, for example for a space outside its directory" style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="310.0" y="203" width="440" height="18" as="geometry"/></mxCell><mxCell id="note-1-0" value="The tray shows unknown only while neither the stream nor the read API delivers anything." style="text;html=1;fontSize=12;fontColor=#5c6270;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="277" width="640" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
